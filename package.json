{
  "name": "qrtrans",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "閃爍 QR 離線檔案傳輸 — 用動態 QR 序列喺兩部裝置之間傳檔案，零後端、零上傳。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nuintun/qrcode": "^5.0.3",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
